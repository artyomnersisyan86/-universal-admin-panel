# ---- Database (pick ONE) ----
# Default: SQLite (no install needed). File is created at server/data/app.sqlite
# Leave DATABASE_URL empty/unset to use SQLite.
# SQLITE_PATH=server/data/app.sqlite

# Alternative: Postgres (used by Docker setup)
# DATABASE_URL=postgres://admin:admin@postgres:5432/admin_panel

# ---- Postgres (only used when running with Docker) ----
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=admin_panel
POSTGRES_PORT=5432

# ---- Server ----
SERVER_PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Seed superadmin on first boot
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=admin

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ---- Client ----
VITE_API_URL=/api
VITE_DEFAULT_LANG=hy
VITE_TINYMCE_API_KEY=
# Where Vite dev server proxies /api → server (when running `npm run dev` without Docker)
VITE_API_PROXY=http://localhost:3000

# ---- Nginx (Docker only) ----
NGINX_HTTP_PORT=80
